{
  "name": "downroad",
  "productName": "Downroad",
  "version": "1.5.3",
  "description": "Download videos and images from YouTube, Instagram, and TikTok. Set in/out points, choose quality, and download clips without fetching the full video.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "postpublish": "node scripts/set-release-notes.js",
    "build:sentry": "node scripts/build-sentry-renderer.js",
    "test": "node --test",
    "check": "node scripts/check-js.js",
    "verify": "npm run build:sentry && npm run check && npm test",
    "postinstall": "node scripts/download-ytdlp.js && node scripts/build-sentry-renderer.js"
  },
  "author": "Grantosthedev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Grantosthedev/Youtube-Converter.git"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "dotenv": "^17.3.1",
    "electron": "^40.8.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@sentry/electron": "^7.15.0",
    "electron-store": "^8.2.0",
    "ffmpeg-static": "^5.3.0"
  }
}
